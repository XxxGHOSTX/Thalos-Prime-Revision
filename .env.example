# Thalos Prime Configuration
# Copy this file to .env and set values as needed.
# All variables are prefixed with THALOS_

# Database URL (SQLite by default)
THALOS_DATABASE_URL=sqlite:///./thalos.db

# Data directory for vector store and cached files
THALOS_DATA_DIR=./thalos_data

# Logging level
THALOS_LOG_LEVEL=INFO

# --- Cloud LLM (optional) ---
# Set THALOS_USE_CLOUD_LLM=true to enable OpenAI-compatible API for answer synthesis
THALOS_USE_CLOUD_LLM=false
THALOS_OPENAI_API_KEY=
THALOS_OPENAI_BASE_URL=https://api.openai.com/v1
THALOS_OPENAI_MODEL=gpt-3.5-turbo

# --- Cloud Translation (optional) ---
# Set THALOS_USE_CLOUD_TRANSLATION=true to use DeepL instead of free Google Translate
THALOS_USE_CLOUD_TRANSLATION=false
THALOS_DEEPL_API_KEY=

# --- Crawling ---
THALOS_MAX_CRAWL_DEPTH=1
THALOS_RESPECT_ROBOTS=true

# --- Claim extraction ---
THALOS_MIN_CLAIM_WORDS=6
THALOS_MAX_CLAIM_WORDS=150

# --- Evidence ---
THALOS_EVIDENCE_TOP_K=10

# --- Verification thresholds ---
THALOS_CLAIM_SCORE_THRESHOLD_CANDIDATE=0.40
THALOS_CLAIM_SCORE_THRESHOLD_VERIFIED=0.65
THALOS_CLAIM_SCORE_THRESHOLD_AUTHORITATIVE=0.85

# --- Autonomy loop ---
THALOS_AUTONOMY_CRON=0 * * * *
THALOS_AUTONOMY_MAX_AGE_DAYS=7

# --- Models ---
THALOS_SPACY_MODEL=en_core_web_sm
THALOS_EMBEDDING_MODEL=all-MiniLM-L6-v2
THALOS_NLI_MODEL=cross-encoder/nli-MiniLM-L6-v2

# --- API server ---
THALOS_API_HOST=0.0.0.0
THALOS_API_PORT=8000
